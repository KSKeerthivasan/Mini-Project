models/**/*.gguf
models/**/*.bin
*.gguf
runtime/llama.cpp/*.exe
runtime/llama.cpp/*.dll

# Logs & Temporary files
logs/*
!logs/.gitkeep
temp/
*.log

# GitNexus & Cache Databases
.gitnexus/lbug
.gitnexus/parse-cache/
.gitnexus/parsedfile-cache/
.qodo/
